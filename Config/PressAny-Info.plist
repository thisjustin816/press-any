				<string>com.thisjustin816.emulator.rom.gbc</string>
				<string>com.rileytestut.delta.game.gbc</string>
				<string>com.provenance.rom.gbc</string>
				<string>com.github.liji32.sameboy.gbc</string>
				<string>com.retroarch.gbc</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Game Boy Save</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.thisjustin816.emulator.save</string>
			</array>
		</dict>
		<!-- Alternate, not Owner: Press Any reads the ROMs, patches and saves in a zip, but other
		     zips should keep opening where they did. Files types a .zip as com.pkware.zip-archive;
		     listing only public.zip-archive left Press Any out of the share sheet. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Zip Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.pkware.zip-archive</string>
				<string>public.zip-archive</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>IPS Patch</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
