			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ips</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.thisjustin816.emulator.patch.bps</string>
			<key>UTTypeDescription</key>
			<string>BPS Patch</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>bps</string>
				</array>
			</dict>
		</dict>
	</array>
